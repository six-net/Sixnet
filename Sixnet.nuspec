<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Sixnet</id>
    <version>$version$</version>
    <title></title>
    <authors>DingBin.Li</authors>
    <owners>DingBin.Li</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
	<license type="expression">MIT</license>
    <projectUrl>https://github.com/sixnet-net</projectUrl>
	<icon>images\nugeticon.png</icon>
    <description>A simple, easy-to-use, flexible, and efficient .NET development framework</description>
    <copyright>Copyright © DingBin.Li</copyright>
    <tags>.NET,Sixnet,DDD</tags>
    <dependencies>
		<dependency id="Microsoft.Bcl.HashCode" version="6.0.0" />
		<dependency id="Microsoft.CSharp" version="4.7.0" />
		<dependency id="Microsoft.Extensions.Configuration.Json" version="9.0.10" />
		<dependency id="Microsoft.Extensions.DependencyInjection" version="9.0.10" />
		<dependency id="Microsoft.Extensions.Hosting" version="9.0.10" />
		<dependency id="Microsoft.Extensions.Http" version="9.0.10" />
		<dependency id="Microsoft.Extensions.Localization" version="9.0.10" />
		<dependency id="Microsoft.Extensions.Logging" version="9.0.10" />
		<dependency id="Microsoft.Extensions.Options.ConfigurationExtensions" version="9.0.10" />
		<dependency id="Microsoft.IdentityModel.JsonWebTokens" version="8.14.0" />
		<dependency id="System.ComponentModel.Annotations" version="5.0.0" />
		<dependency id="System.DirectoryServices.Protocols" version="9.0.10" />
		<dependency id="System.Drawing.Common" version="9.0.10" />
		<dependency id="System.IdentityModel.Tokens.Jwt" version="8.14.0" />
		<dependency id="System.Reflection.Emit" version="4.7.0" />
		<dependency id="System.Reflection.Emit.Lightweight" version="4.7.0" />
		<dependency id="System.Text.Json" version="9.0.10" />
		<dependency id="System.Threading.Channels" version="9.0.10" />
		<dependency id="System.Threading.Tasks.Extensions" version="4.6.3" />
    </dependencies>
  </metadata>
  <files>
    <file src="Sixnet\bin\$configuration$\net6.0\Sixnet.dll" target="lib\net6.0" />
	<file src="Sixnet\bin\$configuration$\net6.0\Sixnet.pdb" target="lib\net6.0" />
    <file src="Sixnet\bin\$configuration$\net8.0\Sixnet.dll" target="lib\net8.0" />
	<file src="Sixnet\bin\$configuration$\net8.0\Sixnet.pdb" target="lib\net8.0" />
	<file src=".\nugeticon.png" target="images\" />
