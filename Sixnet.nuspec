<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Sixnet</id>
    <version>$version$</version>
    <title></title>
    <authors>DingBin.Li</authors>
    <owners>DingBin.Li</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
	<license type="expression">MIT</license>
    <projectUrl>https://github.com/sixnet-net</projectUrl>
	<icon>images\nugeticon.png</icon>
    <description>A simple, easy-to-use, flexible, and efficient .NET development framework</description>
    <copyright>Copyright © DingBin.Li</copyright>
    <tags>.NET,Sixnet,DDD</tags>
    <dependencies>
		<dependency id="Microsoft.Extensions.Hosting" version="10.0.8" />
		<dependency id="Microsoft.Extensions.Http" version="10.0.8" />
		<dependency id="Microsoft.Extensions.Localization" version="10.0.8" />
		<dependency id="Microsoft.IdentityModel.JsonWebTokens" version="8.19.1" />
    </dependencies>
  </metadata>
  <files>
    <file src="Sixnet\bin\$configuration$\net6.0\Sixnet.dll" target="lib\net6.0" />
	<file src="Sixnet\bin\$configuration$\net6.0\Sixnet.pdb" target="lib\net6.0" />
    <file src="Sixnet\bin\$configuration$\net8.0\Sixnet.dll" target="lib\net8.0" />
	<file src="Sixnet\bin\$configuration$\net8.0\Sixnet.pdb" target="lib\net8.0" />
	<file src="Sixnet\bin\$configuration$\net10.0\Sixnet.dll" target="lib\net10.0" />
	<file src="Sixnet\bin\$configuration$\net10.0\Sixnet.pdb" target="lib\net10.0" />
	<file src=".\nugeticon.png" target="images\" />
  </files>
</package>